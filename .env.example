# ARAVEX TECH STUDIO Environment Configuration

# Canonical Website URL (Used for SEO, Metadata, OpenGraph, Canonical URLs)
NEXT_PUBLIC_SITE_URL=https://aravex.tech

# Contact & Lead Generation Form (Resend Integration)
# If left blank, contact submissions will gracefully log locally in dev mode without throwing errors.
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=info@aravextechstudio.com

# Google Sheets Webhook Integration (Training Enrollments & Internship Applications)
# Create a Google Sheet, paste scripts/google-apps-script.js into Extensions > Apps Script, and deploy as Web App
GOOGLE_SHEET_WEBHOOK_URL=

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GA_ID=
