# ARAVEX TECH STUDIO Environment Configuration
# Configure these variables in Netlify under: Site configuration > Environment variables

# Canonical Website URL (Used for SEO, Metadata, OpenGraph, Canonical URLs)
NEXT_PUBLIC_SITE_URL=https://aravex.tech

# Contact & Lead Generation Form (Resend Integration - Optional)
# If left blank, contact submissions will still sync to Google Sheets & send via Google Apps Script MailApp.
RESEND_API_KEY=
CONTACT_RECEIVER_EMAIL=info@aravextechstudio.com

# Google Sheets Webhook Integration (Universal Google Apps Script Webhook)
# Syncs Contact Inquiries, Paid/Unpaid Internships, and Training Enrollments to Google Spreadsheet
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycbxihyVhEepuX1o6y05duxQP4403BmyS0Kdtn51gSc3jNRI0RelBd6AqV21Yopc0TAgtSg/exec

# Analytics & Monitoring (Optional)
NEXT_PUBLIC_GA_ID=
